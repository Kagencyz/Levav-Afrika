# Backend runtime (Stage A)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database — PostgreSQL (Supabase). Use the Supavisor pooler URL in
# production (transaction mode, port 6543). The app connects as the
# dedicated `levav_app` role (created in db/migrations + RLS policies).
DATABASE_URL=postgresql://levav_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth — use the project URL and publishable key. The publishable
# key is safe for Auth requests; never use a service-role/secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# JWT — required outside development; in development an ephemeral secret is
# generated automatically if unset (see api/lib/env.ts)
JWT_SECRET=your-jwt-secret-min-32-characters-long

# Uploads — unused this milestone; the upload router is not registered
VITE_S3_BUCKET=your-bucket
VITE_S3_REGION=us-east-1
VITE_S3_ACCESS_KEY=your-access-key
VITE_S3_SECRET_KEY=your-secret-key
